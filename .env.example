# .env.example — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   chmod 600 .env
#   # then generate JWT_SECRET and LITELLM_MASTER_KEY (commands below)
#
# All variables are interpolated by docker-compose.yaml and docker-compose.litellm.yaml.

# ============================================================================
# Postiz core
# ============================================================================
# Generate with: openssl rand -base64 48 | tr -d '\n=' | tr '/+' '_-'
# Rotating this value invalidates all existing user sessions.
JWT_SECRET=

# ============================================================================
# LiteLLM gateway (docker-compose.litellm.yaml)
# ============================================================================
# Generate with: echo "sk-litellm-local-$(openssl rand -hex 8)"
# This is the bearer token Postiz sends as OPENAI_API_KEY to the LiteLLM proxy.
# It is NOT an upstream provider key.
LITELLM_MASTER_KEY=

# Override of the OpenAI base URL Postiz uses. Defaults to http://litellm:4000/v1
# (the LiteLLM sidecar). Set to empty string to use OpenAI direct (skips LiteLLM).
# OPENAI_BASE_URL=

# ============================================================================
# Upstream provider keys (consumed by the LiteLLM container, NOT Postiz directly)
# Leave blank to disable that provider; LiteLLM falls back to the next available
# entry in litellm/config.yaml.
# ============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
